{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "types": [
            "node",
            "@playwright/test"
        ],
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true,
        "strict": false
    },
    "include": [
        "playwright.config.ts",
        "tests/**/*.ts",
        "pages/**/*.ts",
        "playwright/**/*.ts"
    ]
}